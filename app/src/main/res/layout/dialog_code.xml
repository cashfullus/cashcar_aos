<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_dialog_welcome"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/btnCodeDialogClose"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="16dp"
        android:src="@drawable/ic_btn_x"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvDialogCodeTitle"
        style="@style/body_16_R_lh26"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="신청 코드 입력"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCodeDialogClose" />

    <com.cashfulus.cashcarplus.view.UpgradedEdittext
        android:id="@+id/etCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:hint="신청코드"
        app:inputType="textEmailAddress"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnDialogCode"
        app:layout_constraintEnd_toEndOf="@+id/btnDialogCode"
        app:layout_constraintStart_toStartOf="@+id/btnDialogCode"
        app:layout_constraintTop_toBottomOf="@+id/tvDialogCodeTitle"
        app:maxLines="1" />

    <Button
        android:id="@+id/btnDialogCode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/button_form_active"
        android:text="확인"
        style="@style/display_16_B"
        android:textColor="@color/grayscale_wt"
        app:layout_constraintTop_toBottomOf="@+id/etCode"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>